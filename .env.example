# Production Studio — Example Environment Configuration
# Copy to .env for local development. NEVER commit .env or real keys to GitHub.

# Environment: development | test | production
PRODSTUD_ENV=development

# Private runtime data directory (SQLite DB, encrypted vault key, uploaded references, generated media)
PRODSTUD_DATA_DIR=.prodstud_data

# Optional server-side Fernet master key (32 url-safe base64 bytes). If unset in development, auto-generated inside .prodstud_data/master.key (0600).
# PRODSTUD_MASTER_KEY=

# Optional session signing secret. If unset in development, auto-generated inside .prodstud_data/session.key (0600).
# PRODSTUD_SESSION_SECRET=

# Enable explicitly badged non-billable local_test_fixture provider for offline workflow verification (MUST be false in production)
PRODSTUD_ENABLE_LOCAL_FIXTURE=true

# Default daily spend cap in USD for newly registered users (Hard $0.00 default prevents accidental billable requests)
PRODSTUD_DEFAULT_DAILY_SPEND_CAP_USD=0.00

# API bind host/port
PRODSTUD_HOST=127.0.0.1
PRODSTUD_PORT=8000
